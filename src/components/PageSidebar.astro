---
/**
 * Right-sidebar override: table of contents, then backlinks.
 *
 * The graph is deliberately NOT here. It lives at the bottom of the content
 * column at every width (see Footer.astro) so it can use the full content
 * measure — in a ~250px sidebar the labels overlap and clip.
 *
 * The plugin's own PageSidebar is disabled via `overridePageSidebar: false`.
 */
import Default from '@astrojs/starlight/components/PageSidebar.astro';
import { PageBacklinks } from 'starlight-site-graph/components';
---

<Default>
	<slot />
</Default>

<PageBacklinks class="right-sidebar-panel slsg-backlinks-panel">
	<h2 slot="title">{Astro.locals.t('starlight-site-graph.backlinks')}</h2>
</PageBacklinks>
